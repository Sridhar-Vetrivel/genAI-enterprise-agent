      "groupIds": [],
      "text": "API GATEWAY  +  SEMANTIC CACHE",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "API GATEWAY  +  SEMANTIC CACHE",
