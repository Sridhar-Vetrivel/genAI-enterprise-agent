    {
      "id": "txt_14",
      "type": "text",
      "x": 75,
      "y": 406,
      "width": 1290,
      "height": 20,
      "angle": 0,
      "strokeColor": "#3b5bdb",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "text": "COORDINATOR AGENT  ·  N replicas behind the control plane, autoscaled on queue depth",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "COORDINATOR AGENT  ·  N replicas behind the control plane, autoscaled on queue depth",
      "lineHeight": 1.3
    },
    {
      "id": "txt_15",
      "type": "text",
      "x": 90,
      "y": 436,
      "width": 1260,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "text": "① Tiered intent read: a small distilled/local classifier handles routing first — the large model is called only when routing is ambiguous",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "① Tiered intent read: a small distilled/local classifier handles routing first — the large model is called only when routing is ambiguous",
      "lineHeight": 1.3
    },
    {
      "id": "txt_16",
      "type": "text",
      "x": 90,
      "y": 466,
      "width": 1260,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "text": "② RoutingDecision (typed, schema-validated) selects 1–4 domains — LLM-classified, never keyword-matched",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "② RoutingDecision (typed, schema-validated) selects 1–4 domains — LLM-classified, never keyword-matched",
      "lineHeight": 1.3
    },
    {
      "id": "txt_17",
      "type": "text",
      "x": 90,
      "y": 496,
      "width": 1260,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "text": "③ One task per domain is published to the event bus (Kafka / Azure Service Bus) — async fan-out, decoupled from any one specialist's latency",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "③ One task per domain is published to the event bus (Kafka / Azure Service Bus) — async fan-out, decoupled from any one specialist's latency",
      "lineHeight": 1.3
    },
    {
      "id": "txt_18",
      "type": "text",
      "x": 90,
      "y": 526,
      "width": 1260,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "text": "④ Partial results stream back with a per-call timeout + circuit breaker — one slow or failed specialist cannot hang the whole answer",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "④ Partial results stream back with a per-call timeout + circuit breaker — one slow or failed specialist cannot hang the whole answer",
      "lineHeight": 1.3
    },
    {
      "id": "txt_19",
      "type": "text",
      "x": 90,
      "y": 556,
      "width": 1260,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "text": "⑤ A dedicated citation-verifier pass checks every claim against the record actually returned, before synthesis — the arbiter is the data, not the prose",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "⑤ A dedicated citation-verifier pass checks every claim against the record actually returned, before synthesis — the arbiter is the data, not the prose",
      "lineHeight": 1.3
    },
    {
      "id": "txt_20",
      "type": "text",
      "x": 90,
      "y": 586,
      "width": 1260,
      "height": 22,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "text": "⑥ Synthesized, cited answer streams back to the client — typically <2s end-to-end on a cache miss",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "⑥ Synthesized, cited answer streams back to the client — typically <2s end-to-end on a cache miss",
      "lineHeight": 1.3
    },
